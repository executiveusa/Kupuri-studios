# ===========================================
# KUPURI STUDIOS AI OS - PRODUCTION ENV
# ===========================================
# THE COFOUNDER - Autonomous AI Agency Platform
# For Mexico City & Latin America
# Copy to .env and fill in your values
# ===========================================

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=production
APP_NAME=Kupuri Studios AI OS
APP_VERSION=2.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Frontend
FRONTEND_URL=http://localhost:5173
PRODUCTION_URL=https://kupuri.media

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://kupuri.media

# ===========================================
# DATABASE - SUPABASE
# ===========================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL direct connection (for migrations)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ===========================================
# AI MODELS - LiteLLM Smart Router
# ===========================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# GLM-4 (Self-hosted via LiteLLM)
GLM_API_BASE=http://localhost:4000/v1
GLM_API_KEY=sk-local

# LiteLLM Proxy (if using centralized proxy)
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-master

# Default model selection
DEFAULT_MODEL=glm-4.7
FALLBACK_MODEL=gpt-4o-mini
COMPLEX_MODEL=claude-opus-4.5

# ===========================================
# VIDEO GENERATION - HeyGen
# ===========================================
HEYGEN_API_KEY=your-heygen-api-key
HEYGEN_API_URL=https://api.heygen.com/v2

# Default avatar settings
HEYGEN_DEFAULT_AVATAR=Kristin_public_2_20240108
HEYGEN_DEFAULT_VOICE=es-MX-DaliaNeural

# ===========================================
# VOICE - ElevenLabs
# ===========================================
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-clone-id

# Voice settings
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75

# ===========================================
# TRANSCRIPTION - Whisper
# ===========================================
# Local Whisper (recommended for privacy/cost)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=es

# ===========================================
# PAYMENTS - Stripe
# ===========================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Product/Price IDs
STRIPE_PROFESSIONAL_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxxxxxxxxxx

# ===========================================
# MESSAGING - Chatwoot & WhatsApp
# ===========================================

# Chatwoot
CHATWOOT_API_URL=https://app.chatwoot.com/api/v1
CHATWOOT_API_KEY=your-chatwoot-api-key
CHATWOOT_ACCOUNT_ID=your-account-id
CHATWOOT_INBOX_ID=your-inbox-id

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_VERIFY_TOKEN=kupuri_whatsapp_2024

# ===========================================
# STORAGE
# ===========================================
MEDIA_STORAGE=./data/media
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=100MB

# ===========================================
# SECURITY
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Keys for internal services
INTERNAL_API_KEY=your-internal-api-key

# ===========================================
# MONITORING & LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_VOICE_TO_VIDEO=true
FEATURE_LIGHTNING_ORCHESTRATOR=true
FEATURE_WHATSAPP_BOT=true
FEATURE_AUTO_RESPONSE=true

# ===========================================
# LIMITS & QUOTAS
# ===========================================
FREE_TIER_VIDEOS_PER_MONTH=3
PROFESSIONAL_VIDEOS_PER_MONTH=50
ENTERPRISE_VIDEOS_PER_MONTH=200

FREE_TIER_API_CALLS=100
PROFESSIONAL_API_CALLS=10000
ENTERPRISE_API_CALLS=100000
