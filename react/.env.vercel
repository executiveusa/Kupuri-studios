# Kupuri Studios - Vercel Environment Variables
# =============================================
# Copy these to Vercel Dashboard > Settings > Environment Variables

# API Configuration
VITE_API_BASE_URL=https://api.kupuri.media
VITE_WS_URL=wss://api.kupuri.media

# Stripe (use test keys for preview)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Branding
VITE_BRAND_NAME="Kupuri Studios"
VITE_PRIMARY_COLOR=#7C3AED
VITE_SECONDARY_COLOR=#FF6B35

# Features
VITE_ENABLE_BETA_FEATURES=true
VITE_ENABLE_ANALYTICS=true

# PostHog Analytics (optional)
VITE_PUBLIC_POSTHOG_HOST=https://us.posthog.com
VITE_PUBLIC_POSTHOG_KEY=

# Build
NODE_ENV=production
