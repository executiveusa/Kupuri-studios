{
  "name": "@kupuri/config",
  "version": "0.1.0",
  "description": "Shared configuration for Kupuri Studios ecosystem",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./tailwind": {
      "import": "./tailwind.config.ts",
      "require": "./tailwind.config.ts"
    },
    "./tsconfig": {
      "import": "./tsconfig.json"
    }
  },
  "files": [
    "src",
    "*.config.ts",
    "*.json"
  ],
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
